# Chép file này thành .env.local rồi điền. Trên Vercel khai báo y hệt ở Settings → Environment Variables.

# AI viết bài: điền MỘT trong hai. Có GEMINI_API_KEY thì dùng Gemini.
# Gemini có gói miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Thứ tự model Gemini thử khi quá tải (tùy chọn)
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest
# Claude API (trả phí): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu vào trang duyệt bài
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên bất kỳ, Vercel Cron dùng để gọi /api/cron
CRON_SECRET=

# Facebook Fanpage (bỏ trống thì vẫn soạn bài, chỉ không đăng thẳng được)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# FB_GRAPH_VERSION=v26.0

# TikTok (bỏ trống thì bỏ qua TikTok). Tạo app ở https://developers.tiktok.com:
#  - Thêm sản phẩm Login Kit + Content Posting API (bật Direct Post), scope: user.info.basic, video.publish
#  - Redirect URI: <SITE_URL>/api/tiktok/callback
#  - Xác minh tên miền (URL properties) cho <SITE_URL>/anh/ để TikTok tải được ảnh
#  - App chưa được TikTok duyệt (audit) thì bài chỉ đăng ở chế độ riêng tư
# Rồi vào trang duyệt bài, bấm "Kết nối TikTok" để đăng nhập tài khoản đăng bài.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Link web công khai, ví dụ https://ten-du-an.vercel.app (trên Vercel bỏ trống thì tự lấy tên miền production)
SITE_URL=
# PUBLIC_TO_EVERYONE (mặc định) | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# TIKTOK_CHE_DO=PUBLIC_TO_EVERYONE
# 0 = lịch tự đăng không đăng TikTok (vẫn bấm tay được)
# TIKTOK_TU_DONG_DANG=1
# Lồng tiếng: đăng TikTok dạng video, giọng AI đọc bài kèm phụ đề. 0 = đăng ảnh như cũ
# TIKTOK_LONG_TIENG=1
# Facebook cũng đăng video lồng tiếng (dùng chung video với TikTok). 0 = Facebook đăng ảnh như cũ
# FB_VIDEO=1
# Giọng chính: VieNeu-TTS (giọng Hải Đăng) do "thợ đọc giọng" trên máy nhà (may-nha/tho_doc.py) đọc, lấy việc qua kho Supabase.
# VIENEU_TAT=1 để tắt. Hoặc gọi thẳng máy chủ hf-space/: VIENEU_CHE_DO=url, VIENEU_URL=https://..., VIENEU_KHOA=...
# Giọng dự phòng khi VieNeu lỗi / chưa cài: Puck của Gemini TTS (dùng GEMINI_API_KEY, gói miễn phí 10 lần/ngày)
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Tùy chọn
TEN_TRANG=Tin Công Nghệ
SO_BAI_MOI_LAN=3
# Lịch 6h sáng: 1 = soạn xong đăng thẳng lên Fanpage (mặc định), 0 = chỉ lưu nháp chờ duyệt
TU_DONG_DANG=1

# Báo động Telegram (tùy chọn): đăng lỗi, bài đang lên, đã ẩn spam
# 1. Nhắn @BotFather trên Telegram → /newbot → chép token vào TELEGRAM_BOT_TOKEN
# 2. Nhắn một tin bất kỳ cho bot vừa tạo, rồi mở https://api.telegram.org/bot<token>/getUpdates → chép số ở "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 0 = không tự ẩn bình luận spam trên Fanpage (mặc định bật, cần quyền pages_manage_engagement)
# AN_SPAM_TU_DONG=1

# Ảnh nền miễn phí từ Pixabay (tùy chọn): đăng ký pixabay.com, lấy key ở pixabay.com/api/docs
# Bỏ trống thì ảnh bài dùng nền màu như cũ
PIXABAY_KEY=
