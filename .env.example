# Chép file này thành .env.local rồi điền. Trên Vercel khai báo y hệt ở Settings → Environment Variables.

# AI viết bài: điền MỘT trong hai. Có GEMINI_API_KEY thì dùng Gemini.
# Gemini có gói miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Thứ tự model Gemini thử khi quá tải (tùy chọn)
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest
# Claude API (trả phí): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu vào trang duyệt bài
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên bất kỳ, Vercel Cron dùng để gọi /api/cron
CRON_SECRET=

# Facebook Fanpage (bỏ trống thì vẫn soạn bài, chỉ không đăng thẳng được)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# FB_GRAPH_VERSION=v26.0

# Tùy chọn
TEN_TRANG=Tin Công Nghệ
SO_BAI_MOI_LAN=3
# Lịch 6h sáng: 1 = soạn xong đăng thẳng lên Fanpage (mặc định), 0 = chỉ lưu nháp chờ duyệt
TU_DONG_DANG=1
