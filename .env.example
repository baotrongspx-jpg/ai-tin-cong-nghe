# Chép file này thành .env.local rồi điền. Trên Vercel khai báo y hệt ở Settings → Environment Variables.

# Robot trả lời trên trang CV: điền MỘT trong hai. Có GEMINI_API_KEY thì dùng Gemini.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu vào trang đổi ảnh CV (/cv/doi-anh)
ADMIN_PASSWORD=

# Báo tin liên hệ / lượt xem CV qua Telegram (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
